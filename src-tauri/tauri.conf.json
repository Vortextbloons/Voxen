{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxen",
  "version": "0.1.0",
  "identifier": "com.voxen.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Voxen", "width": 900, "height": 680, "theme": "Dark" }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
